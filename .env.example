APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=true

DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/cafe_mgmt

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=cafe-verify-token-change-me

CAFE_ALLOWED_IPS=1.2.3.4
REQUIRE_CAFE_NETWORK=true

S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=cafe-photos

TIMEZONE=Asia/Jerusalem
DEFAULT_BREAK_MINUTES=30
BREAK_REMINDER_MINUTES_BEFORE=5
QUEUE_POLL_SECONDS=30
